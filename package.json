{
  "name": "3d-browser",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "A three.js machine that browses the web with Chromium, detects a color and redraws it with tiny cubes",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "local:setup": "npm install --no-save puppeteer ws",
    "local": "node server.js",
    "local:headed": "HEADLESS=0 node server.js"
  },
  "devDependencies": {
    "@cloudflare/puppeteer": "^1.1.0",
    "wrangler": "latest"
  },
  "license": "MIT"
}
